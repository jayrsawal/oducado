# Supabase — copy to .env.local and fill in from Project Settings → API Keys

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable key (sb_publishable_...) — safe for the React app
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Secret key (sb_secret_...) — server-side only; do NOT prefix with VITE_
# SUPABASE_SECRET_KEY=sb_secret_your_key_here
